# ==============================================================================
# InvoiceNet Backend - Environment Configuration Example
# DRUNIX × Citi FinTech Hackathon 2026
# ==============================================================================

# Server Network Configuration
# On Render and other PaaS, PORT is provided dynamically. Defaults to 5000 locally.
PORT=5000
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
# Set to your deployed Vercel domain (e.g., https://invoicenet.vercel.app)
# or comma-separated list of allowed origins. Use * for development.
CORS_ORIGIN=*

# Google Gemini AI Configuration
# Used strictly on backend for Document Intelligence, Risk Engine & Copilot.
# NEVER expose this key to frontend or check actual keys into version control.
GEMINI_API_KEY=your_google_gemini_api_key_here

# PostgreSQL / Supabase Relational Database (Phase 2)
# If provided, InvoiceNet connects to PostgreSQL and runs auto-migrations.
# If omitted or unavailable, backend automatically falls back to transactional in-memory replica.
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Authentication & Session Security (Phase 2)
# Secret key used for signing tamper-proof JWT tokens.
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_chars_long
JWT_EXPIRES_IN=24h

# Document Storage Adapter (Phase 2)
# Options: 'local' | 's3' | 'supabase'
# Set to 'local' for local disk uploads/ (default). Set to 's3' or 'supabase' for cloud object storage.
STORAGE_PROVIDER=local
STORAGE_BUCKET=invoicenet-documents
# STORAGE_ENDPOINT=https://your-supabase-ref.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY_ID=your_storage_access_key
# STORAGE_SECRET_ACCESS_KEY=your_storage_secret_key
# STORAGE_REGION=us-east-1

# DRUNIX Ledger Configuration
# Set to true when connected to a live hosted DRUNIX peer network via gRPC.
# Set to false to use the high-performance in-memory deterministic ledger replica.
DRUNIX_LIVE_GATEWAY=false

# DRUNIX Peer and Orderer Endpoints (Optional, for Live Remote Cluster)
# DRUNIX_ORDERER_ENDPOINT=orderer.drunix.yourdomain.com:7050
# DRUNIX_SUPPLIER_PEER=peer0.supplier.drunix.yourdomain.com:7051
# DRUNIX_BUYER_PEER=peer0.buyer.drunix.yourdomain.com:8051
# DRUNIX_FINANCIER_PEER=peer0.financier.drunix.yourdomain.com:9051

# ==============================================================================
# Automated Invoice Reminders & Email Notifications
# ==============================================================================
# Email Provider: 'simulated' | 'smtp' | 'sendgrid' | 'resend'
# Defaults to 'simulated' (logs email dispatch safely without requiring external SMTP credentials)
EMAIL_PROVIDER=simulated
EMAIL_FROM=notifications@invoicenet.io

# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@invoicenet.io
# SMTP_PASS=your_secure_smtp_password_here

# API Key Configuration (required when EMAIL_PROVIDER=sendgrid or resend)
# EMAIL_API_KEY=re_your_api_key_here

