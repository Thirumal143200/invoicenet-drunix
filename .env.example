# ==============================================================================
# InvoiceNet Root Environment Variable Reference
# DRUNIX × Citi FinTech Hackathon 2026
# ==============================================================================

# Backend (Deploy on Render)
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.vercel.app
GEMINI_API_KEY=your_google_gemini_api_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
JWT_SECRET=your_super_secure_jwt_secret_key_min_32_chars_long
JWT_EXPIRES_IN=24h
STORAGE_PROVIDER=local
STORAGE_BUCKET=invoicenet-documents
DRUNIX_LIVE_GATEWAY=false

# Frontend (Deploy on Vercel)
VITE_API_URL=https://your-backend.onrender.com
