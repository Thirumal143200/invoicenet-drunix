# Backend API Endpoint
# In production on Vercel, set this to your Render service URL:
# Example: https://invoicenet-backend.onrender.com
# In local development, leave empty to default to same-origin / proxy (http://localhost:5000)
VITE_API_URL=https://your-render-backend-name.onrender.com
